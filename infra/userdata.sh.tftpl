#!/bin/bash
set -e

mkdir -p /home/ec2-user/servers
echo "${tcp_b64}" | base64 -d > /home/ec2-user/servers/tcp_echo.py
echo "${udp_b64}" | base64 -d > /home/ec2-user/servers/udp_echo.py
chown -R ec2-user:ec2-user /home/ec2-user/servers

cat > /etc/systemd/system/tcp-echo.service << 'EOF'
[Unit]
Description=TCP echo server
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user
ExecStart=/usr/bin/python3 -u /home/ec2-user/servers/tcp_echo.py
Restart=always

[Install]
WantedBy=multi-user.target
EOF

cat > /etc/systemd/system/udp-echo.service << 'EOF'
[Unit]
Description=UDP echo server
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user
ExecStart=/usr/bin/python3 -u /home/ec2-user/servers/udp_echo.py
Restart=always

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now tcp-echo udp-echo